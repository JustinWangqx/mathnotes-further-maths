---
interface Props { name: string; scope?: string }
const {name, scope = 'revision'} = Astro.props;
const captions: Record<string, string> = {
  moments: '绕 O 的顺时针和逆时针 moments。',
  framework: '轻质框架四角的 point masses。',
  sector: '均匀三角形 lamina 的顶点为 O、Q 和 P。',
  string: '半径为 r 的均匀四分之一圆盘。',
  triangle: 'string 的 tension、重量和墙施加的两种 contact forces。',
  holes: '被挖去的三个圆形区域的圆心。',
  wire: '直线 wire 与 linear density 更大的半圆 wire。',
  frustum: '从原 cone 中切去较小的 cone。',
  suspension: 'cone 与 hemisphere 在公共平面 AB 上拼合。',
  toppling: '刚要 toppling 时，重力作用线穿过 C。',
  ladder: 'normal reactions、friction 和两处重量。',
  prism: '绕底部右侧边缘 O 取 moments。',
};
const arrowId = `mechanics-arrow-${scope}-${name}`;
const arrow = `url(#${arrowId})`;
---
<figure class="example-graph mechanics-diagram">
  <svg viewBox="0 0 480 320" role="img" aria-label={captions[name]}>
    <defs><marker id={arrowId} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0L10 5L0 10Z" fill="var(--primary)"/></marker></defs>
    {name === 'moments' && <>
      <path d="M180 75V225H280" class="body-line"/>
      <circle cx="180" cy="225" r="5" class="mass-dot"/>
      <path d="M180 75H305" class="force-line" marker-end={arrow}/><path d="M280 225V155" class="force-line" marker-end={arrow}/>
      <text x="250" y="58">7 N</text><text x="290" y="180">5.5 N</text>
      <text x="125" y="155">3 m</text><text x="220" y="249">2 m</text><text x="158" y="249">O</text>
      <text x="49" y="299">图中标注为垂直距离</text>
    </>}
    {name === 'framework' && <>
      <path d="M110 245H360V95H110Z" class="body-line"/>
      {[{x:110,y:245,label:'A · 2 kg',dx:-65,dy:28},{x:360,y:245,label:'B · 4 kg',dx:-18,dy:28},{x:360,y:95,label:'C · 7 kg',dx:-18,dy:-16},{x:110,y:95,label:'D · 2.5 kg',dx:-65,dy:-16}].map(p=><><circle cx={p.x} cy={p.y} r="5" class="mass-dot"/><text x={p.x+p.dx} y={p.y+p.dy}>{p.label}</text></>)}
      <text x="220" y="295">5 m</text><text x="374" y="183">3 m</text>
    </>}
    {name === 'triangle' && <>
      <path d="M80 250H385V70Z" class="body-shape"/>
      <path d="M260 250V144H275V250Z" fill="#f6c58e" stroke="var(--primary)"/>
      <path d="M80 250H410M80 250V45" class="graph-axis"/>
      <text x="55" y="275">O</text><text x="375" y="275">Q(d, 0)</text><text x="330" y="52">P(d, h)</text>
      <text x="287" y="176">y = hx/d</text><text x="249" y="275">dx</text>
    </>}
    {name === 'sector' && <>
      <path d="M125 255H355A230 230 0 0 0 125 25Z" class="body-shape"/>
      <path d="M125 255L288 92" class="graph-asymptote"/>
      <text x="97" y="279">O</text>
      <text x="225" y="279">r</text><text x="94" y="144">r</text>
      <text x="155" y="217">45°</text>
    </>}
    {name === 'string' && <>
      <path d="M130 25V285" class="body-line"/>
      <path d="M130 270L340 149" class="body-line"/>
      <path d="M340 149L130 28" class="graph-asymptote"/>
      <path d="M340 149L245 94" class="force-line" marker-end={arrow}/>
      <path d="M235 209.5V285" class="force-line" marker-end={arrow}/>
      <path d="M130 270H198" class="force-line" marker-end={arrow}/>
      <path d="M130 270V197" class="force-line" marker-end={arrow}/>
      <text x="110" y="293">A</text><text x="351" y="153">B</text><text x="111" y="24">C</text>
      <text x="270" y="104">T</text><text x="245" y="277">mg</text>
      <text x="164" y="293">R</text><text x="108" y="218">F</text>
      <text x="278" y="160">60°</text><text x="228" y="232">2a</text>
    </>}
    {name === 'holes' && <>
      <circle cx="230" cy="157" r="125" class="body-shape"/>
      <circle cx="180" cy="99" r="33.3" class="hole"/><circle cx="313" cy="132" r="16.7" class="hole"/><circle cx="205" cy="207" r="41.7" class="hole"/>
      <path d="M90 157H375M230 295V20" class="graph-axis"/>
      <text x="112" y="58">A(−6, 7)</text><text x="318" y="121">B(10, 3)</text><text x="115" y="280">C(−3, −6)</text>
      <text x="236" y="177">O</text>
    </>}
    {name === 'wire' && <>
      <path d="M190 275V55" class="body-line"/>
      <path d="M190 55A55 55 0 0 1 190 165" fill="none" stroke="var(--primary)" stroke-width="6"/>
      <path d="M190 275H335" class="graph-axis"/><path d="M190 110H245" class="graph-asymptote"/>
      <text x="163" y="297">O</text><text x="80" y="58">(0, 4a)</text><text x="80" y="172">(0, 2a)</text>
      <text x="260" y="108">半径 a</text><text x="280" y="72">density 3λ</text><text x="62" y="226">density λ</text>
      <circle cx="190" cy="110" r="3" class="mass-dot"/><text x="202" y="133">(0, 3a)</text>
    </>}
    {name === 'frustum' && <>
      <path d="M90 160L405 55V265Z" fill="none" stroke="#a19387" stroke-dasharray="6 5"/>
      <path d="M195 125L405 55V265L195 195Z" class="body-shape"/>
      <path d="M90 160H430" class="graph-asymptote"/>
      <text x="68" y="180">V</text><text x="153" y="94">a</text><text x="280" y="38">base radius a</text>
      <path d="M90 294H405" class="graph-axis"/><text x="230" y="284">3a</text>
      <text x="175" y="225">smaller face</text>
    </>}
    {name === 'suspension' && <>
      <path d="M145 55A105 105 0 0 0 145 265L460 160Z" class="body-shape"/>
      <path d="M145 55V265M145 160H460" class="graph-asymptote"/>
      <text x="128" y="42">A</text><text x="125" y="287">B</text><text x="122" y="179">O</text>
      <text x="105" y="116">r</text>
      <text x="255" y="195">3r</text><text x="63" y="218">density ρ</text><text x="270" y="245">density 4ρ</text>
    </>}
    {name === 'toppling' && <>
      <path d="M90 258L370 145" class="body-line"/>
      <path d="M137 239L83.33 131.67L137 104.84L190.67 212.17Z" class="body-shape"/>
      <path d="M137 239V173" class="graph-asymptote"/>
      <circle cx="137" cy="173" r="5" class="mass-dot"/>
      <path d="M137 173V239" class="force-line" marker-end={arrow}/>
      <text x="149" y="170">G</text><text x="131" y="265">C</text><text x="153" y="211">W</text>
      <text x="55" y="180">2a</text><text x="149" y="236">a</text>
      <path d="M90 258H270" class="graph-axis"/><text x="250" y="239">θ</text>
    </>}
    {name === 'ladder' && <>
      <path d="M175 35V270H385" class="body-line"/>
      <path d="M175 55L300 270" class="body-line"/>
      <path d="M175 55H260" class="force-line" marker-end={arrow}/><path d="M300 270V195" class="force-line" marker-end={arrow}/><path d="M300 270H225" class="force-line" marker-end={arrow}/>
      <path d="M237.5 162.5V232" class="force-line" marker-end={arrow}/><path d="M268.75 216.25V280" class="force-line" marker-end={arrow}/>
      <text x="220" y="44">S</text><text x="312" y="211">R</text><text x="240" y="298">F</text>
      <text x="185" y="233">2mg</text><text x="270" y="302">5mg</text><text x="179" y="107">30°</text>
      <text x="329" y="269">B</text><text x="153" y="52">A</text>
    </>}
    {name === 'prism' && <>
      <path d="M115 260V55L350 260Z" class="body-shape"/>
      <path d="M115 55H240" class="force-line" marker-end={arrow}/>
      <path d="M193 192V285" class="force-line" marker-end={arrow}/>
      <path d="M350 260V184" class="force-line" marker-end={arrow}/><path d="M350 260H283" class="force-line" marker-end={arrow}/>
      <text x="185" y="42">X</text><text x="65" y="170">2a</text><text x="238" y="283">a</text>
      <text x="202" y="218">mg</text><text x="360" y="201">R</text><text x="297" y="248">F</text><text x="355" y="284">O</text>
      <circle cx="193" cy="192" r="5" class="mass-dot"/><text x="202" y="185">G</text>
    </>}
  </svg>
  <figcaption>{captions[name]}</figcaption>
</figure>
