---
import { type Topic, topicUrl, url } from '../data/curriculum';
import { questionTypes } from '../data/question-types';
import { papersForTopic } from '../data/paper-collections';
import Icon from './Icon.astro';

interface Props { topics: Topic[] }
const { topics } = Astro.props;
---
<div class="topic-list">
  {topics.map(topic => {
    const href = topicUrl(topic);
    const collections = papersForTopic(topic.id);
    return (
      <div class="topic-row" id={topic.id} data-filter-card data-module={topic.module}
        data-search={topic.title + ' ' + topic.description + ' ' + topic.aliases.join(' ')}>
        <span class="topic-ref">{topic.ref}</span>
        <div>
          <h3><a href={href} lang="en">{topic.title}</a></h3>
          <p>{topic.description} · {questionTypes[topic.id].length} 个题型</p>
        </div>
        {collections.length > 0 && <a class="topic-paper-link" href={url('papers/?topic=' + topic.id)}>试题 <Icon name="papers" size={14}/></a>}
        <a class="icon-button" aria-label={'阅读 ' + topic.title} href={href}><Icon name="arrow" size={18}/></a>
      </div>
    );
  })}
</div>
