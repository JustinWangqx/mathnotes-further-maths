---
import {type Topic,learnUrl,topicUrl,url} from '../data/curriculum';
import {questionTypes} from '../data/question-types';
import {papersForTopic} from '../data/paper-collections';
import Icon from './Icon.astro';
interface Props { topics: Topic[]; mode?: 'learn' | 'revision' }
const {topics, mode = 'revision'} = Astro.props;
---
<div class="topic-list">{topics.map(topic=>{
  const href = mode === 'learn' ? learnUrl(topic) : topicUrl(topic);
  const collections=papersForTopic(topic.id);
  return <div class="topic-row" id={topic.id} data-filter-card data-module={topic.module} data-search={`${topic.title} ${topic.description} ${topic.aliases.join(' ')}`}><span class="topic-ref">{topic.ref}</span><div><h3><a href={href}>{topic.title}</a></h3><p>{mode === 'learn' ? topic.description : `${questionTypes[topic.id].length} question types${collections.length ? ` · ${collections.length} paper collection${collections.length===1?'':'s'}` : ''}`}</p></div>{mode === 'revision' && collections.length>0&&<a class="topic-paper-link" href={`${url('papers/')}?topic=${topic.id}`}>Papers <Icon name="papers" size={14}/></a>}<a class="icon-button" aria-label={`Read ${topic.title}`} href={href}><Icon name="arrow" size={18}/></a></div>;
})}</div>
