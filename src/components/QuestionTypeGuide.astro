---
import MathText from './MathText.astro';
import ExampleGraph from './ExampleGraph.astro';
import {questionTypes} from '../data/question-types';
interface Props {topicId: string}
const types=questionTypes[Astro.props.topicId];
---
<div class="question-types">
  {types.map(type=><section class="exam-type" id={type.id} data-question-type>
    <header class="type-heading"><span class="type-number">TYPE {String(type.number).padStart(2,'0')}</span><h2>{type.title}</h2></header>
    <div class="type-method"><span class="type-label">METHOD</span><p><MathText text={type.method}/></p></div>
    <div class="type-formula" aria-label={`Formula for type ${type.number}`}><MathText text={type.formula}/></div>
    <div class="type-example">
      <div class="example-caption"><span class="type-label">WORKED EXAMPLE</span><span>{type.source.kind==='textbook' ? 'From textbook / worksheet questions in your notes' : 'Illustration from your annotated methods'}</span></div>
      <p class="type-question"><MathText text={type.question}/></p>
      <ol class="type-working">{type.steps.map(step=><li><MathText text={step}/></li>)}</ol>
      <div class="type-answer"><span class="type-label">ANSWER</span><div><MathText text={type.answer}/></div></div>
      {type.diagram&&<ExampleGraph name={type.diagram}/>}
      <details class="example-source"><summary>{type.source.label} · notes p. {type.source.pages}</summary><p>{type.source.file}</p><p>Question wording is shortened for revision. Worked calculations are typeset and checked; source examples are identified above.</p></details>
    </div>
  </section>)}
</div>
