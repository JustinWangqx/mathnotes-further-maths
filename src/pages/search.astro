---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {modules,topics,url} from '../data/curriculum';
---
<Base title="搜索笔记与试题" active="search" noindex>
<div class="page-heading"><span class="eyebrow">CIE / CAIE · CAMBRIDGE INTERNATIONAL</span><h1>搜索 MathNotes</h1><p>搜索 A Level Further Mathematics (9231) 的概念、题型和历年试题。支持中文关键词和英文术语。</p></div>
<div class="search-box"><Icon name="search" size={21}/><label for="site-search" class="sr-only">搜索笔记和试题</label><input id="site-search" type="search" placeholder="例如 integration papers、复数、MF19…" autocomplete="off" autofocus aria-controls="search-results"/></div>
<div class="filter-bar search-filters"><label>资料类型<select id="search-kind"><option value="all">全部资料</option><option value="notes">专题笔记</option><option value="papers">历年试题</option><option value="resources">参考资料</option></select></label><label>模块<select id="search-module"><option value="all">全部模块</option>{modules.map(m=><option value={m.id}>{m.title}</option>)}</select></label></div>
<div class="search-suggestions"><span>试试这些关键词</span>{['矩阵笔记','integration papers','复数','MF19'].map(q=><button class="search-chip" data-search-term={q}>{q}</button>)}</div>
<p class="search-status" id="search-status" role="status" aria-live="polite">输入专题、解法或试题中的关键词。</p><div id="search-results" aria-busy="false"></div>
<noscript><p class="search-fallback">搜索需要 JavaScript。你也可以浏览<a href={url('notes/')}>专题笔记</a>或<a href={url('papers/')}>历年试题</a>。</p></noscript>
<details class="search-aliases"><summary>中英文搜索词</summary><p>{topics.map(t=>`${t.title}: ${t.aliases.filter(a=>/[^\x00-\x7F]/.test(a)).join(', ')}`).join(' · ')}</p></details>
<script>
  import {searchCatalog} from '../utils/search.mjs';
  const input=document.querySelector<HTMLInputElement>('#site-search')!,kind=document.querySelector<HTMLSelectElement>('#search-kind')!,module=document.querySelector<HTMLSelectElement>('#search-module')!;
  const status=document.querySelector<HTMLElement>('#search-status')!,output=document.querySelector<HTMLElement>('#search-results')!;
  const base=document.body.dataset.base!;
  type Entry={title:string;href:string;description:string;kind:string;module:string;section?:boolean};
  let catalogPromise:Promise<any>|undefined,sequence=0;
  const labels:Record<string,string>={notes:'专题笔记',papers:'历年试题',resources:'参考资料'};
  const moduleLabels:Record<string,string>={fp1:'Further Pure 1',fp2:'Further Pure 2',mechanics:'Further Mechanics',statistics:'Further Statistics'};
  function addResult(record:Entry){
    const result=document.createElement('article');result.className='search-result';
    const label=document.createElement('span');label.className='search-result-kind';label.textContent=[record.section?'题型':labels[record.kind],moduleLabels[record.module]].filter(Boolean).join(' · ');
    const heading=document.createElement('h2'),link=document.createElement('a');link.href=record.href;link.textContent=record.title;heading.append(link);
    const p=document.createElement('p');p.textContent=record.description;result.append(label,heading,p);output.append(result);
  }
  async function search(){
    const query=input.value.trim(),current=++sequence;output.replaceChildren();
    const params=new URLSearchParams();if(query)params.set('q',query);if(kind.value!=='all')params.set('type',kind.value);if(module.value!=='all')params.set('module',module.value);
    history.replaceState(null,'',`${location.pathname}${params.size?'?'+params:''}`);
    if(!query&&kind.value==='all'&&module.value==='all'){output.setAttribute('aria-busy','false');status.textContent='输入专题、解法或试题中的关键词。';return;}
    status.textContent='正在搜索…';output.setAttribute('aria-busy','true');
    try{
      catalogPromise??=fetch(`${base}search-index.json`).then(r=>{if(!r.ok)throw new Error('Search index unavailable');return r.json();});
      const catalog=await catalogPromise;if(current!==sequence)return;
      const {plan,results}=searchCatalog(catalog,query,{kind:kind.value,module:module.value});results.forEach(addResult);
      const scope=[plan.kind!=='all'?labels[plan.kind]:null,moduleLabels[plan.module]].filter(Boolean).join(' · ');
      status.textContent=results.length ? '找到 '+results.length+' 条结果'+(scope?' · '+scope:'') : '没有匹配的资料。试试其他关键词或筛选条件。';
    }catch{
      catalogPromise=undefined;if(current!==sequence)return;
      status.textContent='暂时无法加载搜索。请重试，或按专题浏览。';
      addResult({title:'专题笔记',href:`${base}notes/`,description:'按模块查看概念、推导和题型。',kind:'notes',module:''});
      addResult({title:'历年试题',href:`${base}papers/`,description:'浏览完整的试题汇编。',kind:'papers',module:''});
    }finally{if(current===sequence)output.setAttribute('aria-busy','false');}
  }
  let timer:ReturnType<typeof setTimeout>;
  input.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(search,180);});
  [kind,module].forEach(select=>select.addEventListener('change',search));
  document.querySelectorAll<HTMLButtonElement>('[data-search-term]').forEach(button=>button.addEventListener('click',()=>{input.value=button.dataset.searchTerm!;kind.value='all';module.value='all';input.focus();search();}));
  const initial=new URLSearchParams(location.search);input.value=initial.get('q')||'';
  const type=initial.get('type');
  if(type==='learn')kind.value='notes';
  else if(type && ['notes','papers','resources'].includes(type))kind.value=type;
  if(['fp1','fp2','mechanics','statistics'].includes(initial.get('module')||''))module.value=initial.get('module')!;
  if(input.value||kind.value!=='all'||module.value!=='all')search();
</script>
</Base>
