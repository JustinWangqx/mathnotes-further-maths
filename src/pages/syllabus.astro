---
import Base from '../layouts/Base.astro';
import {questions} from '../data/practice';
import Icon from '../components/Icon.astro';
import {modules,topics,topicUrl,syllabusUrl,url} from '../data/curriculum';
---
<Base title="Topic map" active="syllabus"><div class="page-heading"><span class="eyebrow">SEE HOW IT FITS TOGETHER</span><h1>Your notes,<br/><em>connected.</em></h1><p>Cambridge International 9231 · 2026–2027 syllabus. Only topics represented in the current study collection are included.</p></div>
<div class="coverage-summary"><div><strong>14<span> / 14</span></strong><p>topics from your notes</p></div><div><strong>48</strong><p>original practice questions</p></div><a class="button secondary" href={syllabusUrl}>Official syllabus <Icon name="external" size={15}/></a></div>
{modules.map(m=><section class="section syllabus-section" id={m.id}><div class="section-heading"><div class="module-title"><span class={`module-icon ${m.color}`}><Icon name={m.icon} size={24}/></span><div><span class="eyebrow">{m.paper}</span><h2>{m.title}</h2></div></div><a class="text-link" href={url(`9231/${m.id}/`)}>Explore module <Icon name="arrow" size={16}/></a></div><div class="topic-list">{topics.filter(t=>t.module===m.id).map(t=><div class="topic-row" id={t.id}><span class="topic-ref">{t.ref}</span><div><h3>{t.slug?<a href={topicUrl(t)}>{t.title}</a>:t.title}</h3><p>{t.slug?`Notes, examples and ${questions.filter(q=>q.topic===t.id).length} practice questions`:t.sourceAvailable?'Source material collected · English guide planned':'Guide planned · source material needed'}</p></div><span class:list={['status',{published:!!t.slug}]}>{t.slug?'Available':'Planned'}</span>{t.slug&&<a class="icon-button" aria-label={`Read ${t.title}`} href={topicUrl(t)}><Icon name="arrow" size={18}/></a>}</div>)}</div></section>)}
<div class="notice"><Icon name="info"/><div><strong>Coverage, without the guesswork</strong><p>“Available” means a guide exists for that topic, not that every syllabus objective has been covered. This map covers the current note collection rather than the full qualification. Each guide states its scope and review status.</p></div></div>
</Base>
