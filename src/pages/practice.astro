---
import Base from '../layouts/Base.astro';
import PracticeCard from '../components/PracticeCard.astro';
import Icon from '../components/Icon.astro';
import {questions} from '../data/practice';
import {availableTopics,modules} from '../data/curriculum';
---
<Base title="Topic practice" active="practice"><div class="page-heading"><span class="eyebrow">THINK IT THROUGH</span><h1>A little practice.<br/><em>A deeper understanding.</em></h1><p>Original questions with hints, full working and a reason behind every step.</p></div>
<div class="filter-bar"><label>Module<select data-filter="module" aria-label="Module"><option value="all">All modules</option>{modules.slice(0,3).map(m=><option value={m.id}>{m.title}</option>)}</select></label><label>Topic<select data-filter="topic" aria-label="Topic"><option value="all">All topics</option>{availableTopics.map(t=><option value={t.id}>{t.title}</option>)}</select></label><label>Level<select data-filter="difficulty" aria-label="Level"><option value="all">All levels</option><option value="foundation">Foundation</option><option value="standard">Standard</option><option value="stretch">Stretch</option></select></label></div>
<p class="result-line"><strong data-result-count>48</strong> questions <span>· Try first, reveal when you’re ready.</span></p><div class="practice-list">{questions.map((q,i)=><PracticeCard question={q} number={i+1}/>)}</div><div class="empty-state" data-empty hidden><Icon name="pen" size={32}/><h2>No questions match these filters</h2><p>Choose a different module, topic or level to continue.</p><a href="./" class="button secondary">Reset filters</a></div>
</Base>
