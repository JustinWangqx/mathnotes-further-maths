---
import Base from '../layouts/Base.astro';
import {totalTypes} from '../data/question-types';
import {paperCollections,totalPaperQuestions} from '../data/paper-collections';
import Icon from '../components/Icon.astro';
import TopicCard from '../components/TopicCard.astro';
import {availableTopics,modules,url} from '../data/curriculum';
---
<Base>
<div class="home-top"><span class="eyebrow">FURTHER MATHEMATICS 专题笔记</span><span class="edition-pill"><span class="tiny-dot"></span> 2026–2027 考纲</span></div>
<section class="hero">
  <div class="hero-copy"><h1>CIE A Level<br/><em>Further Mathematics</em></h1><p>用中文学习 Cambridge International Further Mathematics (9231)。按专题查看概念、推导、常考题型与例题，再用历年试题练习。</p><div class="hero-actions"><a class="button primary" href={url('notes/')}>浏览专题笔记 <Icon name="arrow" size={18}/></a><a class="text-link" href={url('papers/')}>历年试题 <Icon name="arrow" size={14}/></a></div><div class="hero-caption"><span class="mini-rule"></span> Cambridge International 9231 · 笔记与试题</div></div>
  <div class="hero-art" aria-hidden="true"><svg viewBox="0 0 440 330" fill="none"><defs><pattern id="grid" width="27" height="27" patternUnits="userSpaceOnUse"><path d="M27 0H0V27" stroke="#d2beac" stroke-width=".55"/></pattern><marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="m0 0 10 5L0 10" fill="#8e7563"/></marker></defs><rect x="25" y="20" width="385" height="290" rx="8" fill="url(#grid)"/><circle cx="242" cy="162" r="106" stroke="#bbaa9e" stroke-dasharray="4 6"/><path d="M52 216H401M134 292V38" stroke="#8e7563" marker-end="url(#arrow)"/><path d="M57 244C97 246 109 98 171 101s62 169 125 127 63-105 99-111" stroke="#b57b52" stroke-width="3.4"/><path d="M134 216 282 74" stroke="#584032" stroke-width="2.4" marker-end="url(#arrow)"/><path d="M134 216h148V74" stroke="#8e7563" stroke-dasharray="4 5"/><circle cx="282" cy="74" r="5" fill="#584032"/><circle cx="171" cy="101" r="4" fill="#b57b52"/><text x="292" y="66" fill="#584032" font-size="16" font-family="Georgia,serif" font-style="italic">z = r eⁱᶿ</text><text x="75" y="74" fill="#aa7149" font-family="Georgia,serif" font-size="19" font-style="italic">f(x)</text><text x="142" y="244" fill="#816a59" font-family="Georgia,serif" font-size="13">0</text><text x="396" y="237" fill="#816a59" font-family="Georgia,serif" font-size="14">x</text><text x="113" y="45" fill="#816a59" font-family="Georgia,serif" font-size="14">y</text><path d="M167 216a33 33 0 0 0-9-23" stroke="#8e7563"/><text x="177" y="201" fill="#584032" font-family="Georgia,serif" font-size="17" font-style="italic">θ</text></svg><span class="art-note"></span><span class="art-corner"></span></div>
</section>
<div class="intro-strip"><span><Icon name="book" size={17}/> {totalTypes} 个题型 · {availableTopics.length} 个专题</span><span><Icon name="pen" size={17}/> {paperCollections.length} 套试题 · {totalPaperQuestions} 道完整试题</span><span><Icon name="check" size={17}/> 免费阅读，无需登录。</span></div>
<section class="section"><div class="section-heading"><div><span class="eyebrow">推荐专题</span><h2>从一个专题开始</h2></div><a class="text-link" href={url('notes/')}>全部专题 <Icon name="arrow" size={17}/></a></div><div class="topic-grid">{availableTopics.filter(t=>['roots','complex','pdf-cdf'].includes(t.id)).map((topic,i)=><TopicCard topic={topic} number={i+1}/>)}</div></section>
<section class="section course-section"><div class="section-heading"><div><span class="eyebrow">按考纲浏览</span><h2>四个模块</h2></div><a class="text-link" href={url('notes/')}>全部专题 <Icon name="arrow" size={17}/></a></div><div class="module-grid">{modules.map(m=><a class="module-card" href={url(`9231/${m.id}/`)}><span class={`module-icon ${m.color}`}><Icon name={m.icon} size={24}/></span><div><span class="eyebrow">{m.paper}</span><h3>{m.title}</h3><p>{availableTopics.filter(t=>t.module===m.id).length} 个专题</p></div><Icon name="chevron" size={18}/></a>)}</div></section>
<section class="practice-banner"><div class="banner-icon"><Icon name="pen" size={31}/></div><div><span class="eyebrow">历年试题</span><h2>练习完整试题</h2><p>试题 PDF 保留原有小题、图表和页序。</p></div><a class="button light" href={url('papers/')}>浏览历年试题 <Icon name="arrow" size={18}/></a></section>
<div class="home-footnote"><span>课程范围</span><p>笔记覆盖现有的 15 个 Further Mathematics 专题。MF19 公式表也适用于 A Level Mathematics (9709)。</p><a href={url('about/')}>关于本站 <Icon name="arrow" size={15}/></a></div>
</Base>
