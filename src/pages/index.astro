---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TopicCard from '../components/TopicCard.astro';
import {availableTopics,modules,url} from '../data/curriculum';
---
<Base>
<div class="home-top"><span class="eyebrow">THE FURTHER MATHEMATICS NOTEBOOK</span><span class="edition-pill"><span class="tiny-dot"></span> 2026–2027 edition</span></div>
<section class="hero">
  <div class="hero-copy"><h1>Make sense of<br/><em>further maths.</em></h1><p>Clear notes. Thoughtful examples. Practice that connects the dots. A little more understanding, one topic at a time.</p><div class="hero-actions"><a class="button primary" href={url('notes/')}>Explore the notes <Icon name="arrow" size={18}/></a><a class="text-link" href={url('syllabus/')}>View topic map <Icon name="arrow" size={14}/></a></div><div class="hero-caption"><span class="mini-rule"></span> Built around Cambridge International 9231</div></div>
  <div class="hero-art" aria-hidden="true"><svg viewBox="0 0 440 330" fill="none"><defs><pattern id="grid" width="27" height="27" patternUnits="userSpaceOnUse"><path d="M27 0H0V27" stroke="#c4c7b7" stroke-width=".55"/></pattern><marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="m0 0 10 5L0 10" fill="#718078"/></marker></defs><rect x="25" y="20" width="385" height="290" rx="8" fill="url(#grid)"/><circle cx="242" cy="162" r="106" stroke="#a8b4a5" stroke-dasharray="4 6"/><path d="M52 216H401M134 292V38" stroke="#718078" marker-end="url(#arrow)"/><path d="M57 244C97 246 109 98 171 101s62 169 125 127 63-105 99-111" stroke="#b76e50" stroke-width="3.4"/><path d="M134 216 282 74" stroke="#345649" stroke-width="2.4" marker-end="url(#arrow)"/><path d="M134 216h148V74" stroke="#6c8571" stroke-dasharray="4 5"/><circle cx="282" cy="74" r="5" fill="#345649"/><circle cx="171" cy="101" r="4" fill="#b76e50"/><text x="292" y="66" fill="#345649" font-size="16" font-family="Georgia,serif" font-style="italic">z = r eⁱᶿ</text><text x="75" y="74" fill="#ac6447" font-family="Georgia,serif" font-size="19" font-style="italic">f(x)</text><text x="142" y="244" fill="#65756a" font-family="Georgia,serif" font-size="13">0</text><text x="396" y="237" fill="#65756a" font-family="Georgia,serif" font-size="14">x</text><text x="113" y="45" fill="#65756a" font-family="Georgia,serif" font-size="14">y</text><path d="M167 216a33 33 0 0 0-9-23" stroke="#6c8571"/><text x="177" y="201" fill="#345649" font-family="Georgia,serif" font-size="17" font-style="italic">θ</text></svg><span class="art-note">Different ideas. Connected.</span><span class="art-corner">FIG. 01 / FINDING THE PATTERN</span></div>
</section>
<div class="intro-strip"><span><Icon name="book" size={17}/> 14 topic guides</span><span><Icon name="pen" size={17}/> 48 original practice questions</span><span><Icon name="check" size={17}/> Free to explore. No account needed.</span></div>
<section class="section"><div class="section-heading"><div><span class="eyebrow">A GOOD PLACE TO BEGIN</span><h2>Find your next “I get it.”</h2></div><a class="text-link" href={url('notes/')}>All study notes <Icon name="arrow" size={17}/></a></div><div class="topic-grid">{availableTopics.filter(t=>['roots','complex','pdf-cdf'].includes(t.id)).map((topic,i)=><TopicCard topic={topic} number={i+1}/>)}</div></section>
<section class="section course-section"><div class="section-heading"><div><span class="eyebrow">THE BIGGER PICTURE</span><h2>Your course, connected.</h2></div><a class="text-link" href={url('syllabus/')}>Topic map <Icon name="arrow" size={17}/></a></div><div class="module-grid">{modules.slice(0,3).map(m=><a class="module-card" href={url(`9231/${m.id}/`)}><span class={`module-icon ${m.color}`}><Icon name={m.icon} size={24}/></span><div><span class="eyebrow">{m.paper}</span><h3>{m.title}</h3><p>{m.id==='fp1'?'5 topic guides':m.id==='fp2'?'4 topic guides':'5 topic guides'} <span>·</span> Available now</p></div><Icon name="chevron" size={18}/></a>)}</div></section>
<section class="practice-banner"><div class="banner-icon"><Icon name="pen" size={31}/></div><div><span class="eyebrow">PUT THE IDEA TO WORK</span><h2>Understanding grows with practice.</h2><p>Try a question, take a hint, then follow the reasoning.</p></div><a class="button light" href={url('practice/')}>Start practising <Icon name="arrow" size={18}/></a></section>
<div class="home-footnote"><span>YOUR CURRENT NOTES, CONNECTED</span><p>Fourteen topics from the study collection, across Pure and Statistics.</p><a href={url('about/')}>A note about this project <Icon name="arrow" size={15}/></a></div>
</Base>
