---
import Base from '../layouts/Base.astro';
import TopicRows from '../components/TopicRows.astro';
import Icon from '../components/Icon.astro';
import {modules,topics,syllabusUrl,url} from '../data/curriculum';
import {totalTypes} from '../data/question-types';
import {paperCollections} from '../data/paper-collections';
---
<Base title="Topic map" seoTitle="CIE A Level Further Mathematics Notes & Topic Map | MathNotes" description="Cambridge International (CIE/CAIE) Further Mathematics 9231 revision notes: 14 topics and 78 exam question types in Further Pure 1, Further Pure 2 and Statistics." active="notes"><div class="page-heading"><span class="eyebrow">YOUR NOTES, IN ORDER</span><h1>Find your topic.<br/><em>Follow the method.</em></h1><p>CIE A Level Further Mathematics (9231) revision notes, grouped by module and ordered by syllabus topic. Open a topic for its numbered question types and worked examples.</p></div>
<div class="coverage-summary"><div><strong>{topics.length}</strong><p>topics from your notes</p></div><div><strong>{totalTypes}</strong><p>question types</p></div><a class="button secondary" href={url('papers/')}>{paperCollections.length} paper collections <Icon name="arrow" size={15}/></a></div>
<div class="filter-bar topic-map-filters"><label>Module<select data-filter="module" aria-label="Module"><option value="all">All modules</option>{modules.map(m=><option value={m.id}>{m.title}</option>)}</select></label><label class="filter-search">Find a topic<input type="search" placeholder="Try integration or 积分" data-filter="query"/></label></div><p class="result-line"><strong data-result-count>{topics.length}</strong> topics in your notes</p>
{modules.map(m=><section class="section syllabus-section" id={m.id} data-filter-section><div class="section-heading"><div class="module-title"><span class={`module-icon ${m.color}`}><Icon name={m.icon} size={24}/></span><div><span class="eyebrow">{m.paper}</span><h2>{m.title}</h2></div></div><a class="text-link" href={url(`9231/${m.id}/`)}>Explore module <Icon name="arrow" size={16}/></a></div><TopicRows topics={topics.filter(t=>t.module===m.id)}/></section>)}
<div class="empty-state" data-empty hidden><h2>No matching topics</h2><p>Try another module or a broader search.</p></div><p class="map-source"><a href={syllabusUrl}>2026–2027 Cambridge 9231 syllabus ↗</a> · Only topics represented in your supplied notes are listed.</p>
</Base>
