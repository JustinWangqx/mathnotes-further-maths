---
import Base from '../layouts/Base.astro';
import TopicRows from '../components/TopicRows.astro';
import Icon from '../components/Icon.astro';
import { modules, topics, syllabusUrl, url } from '../data/curriculum';
import { totalTypes } from '../data/question-types';
import { paperCollections } from '../data/paper-collections';
---
<Base title="专题笔记" seoTitle="专题笔记 · CIE A Level Further Mathematics 9231 | MathNotes"
  description="Cambridge International Further Mathematics 9231 中文笔记。每个专题按概念、推导和题型例题编排，数学术语保留英文。" active="notes">
  <div class="page-heading">
    <span class="eyebrow">CIE A LEVEL · FURTHER MATHEMATICS 9231</span>
    <h1>专题笔记</h1>
    <p>按考纲顺序浏览。每个专题先讲概念和推导，再整理常见题型、公式及例题。</p>
  </div>
  <div class="coverage-summary">
    <div><strong>{topics.length}</strong><p>个专题</p></div>
    <div><strong>{totalTypes}</strong><p>个题型</p></div>
    <a class="button secondary" href={url('papers/')}>{paperCollections.length} 套试题 <Icon name="arrow" size={15}/></a>
  </div>
  <div class="filter-bar topic-map-filters">
    <label>模块<select data-filter="module"><option value="all">全部模块</option>{modules.map(m=><option value={m.id}>{m.title}</option>)}</select></label>
    <label class="filter-search">查找专题<input type="search" placeholder="例如 Integration、积分" data-filter="query"/></label>
  </div>
  <p class="result-line">共 <strong data-result-count>{topics.length}</strong> 个专题</p>
  {modules.map(m => <section class="section syllabus-section" id={m.id} data-filter-section>
    <div class="section-heading">
      <div class="module-title">
        <span class={['module-icon',m.color].join(' ')}><Icon name={m.icon} size={24}/></span>
        <div><span class="eyebrow">{m.paper}</span><h2 lang="en">{m.title}</h2></div>
      </div>
    </div>
    <TopicRows topics={topics.filter(t=>t.module===m.id)}/>
  </section>)}
  <div class="empty-state" data-empty hidden><h2>未找到匹配的专题</h2><p>试试其他模块或更简短的关键词。</p></div>
  <p class="map-source"><a href={syllabusUrl}>Cambridge 9231 考纲（2026–2027）↗</a></p>
</Base>
