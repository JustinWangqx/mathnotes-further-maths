---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import {paperCollections,collectionUrl,type PaperCollection} from '../../data/paper-collections';
import {topics,topicUrl,moduleFor,url,formulaSheetUrl} from '../../data/curriculum';
export function getStaticPaths(){return paperCollections.map(paper=>({params:{collection:paper.id},props:{paper}}));}
const {paper}=Astro.props as {paper:PaperCollection};
const topic=topics.find(t=>t.id===paper.topic)!;
const index=paperCollections.findIndex(p=>p.id===paper.id);
const next=paperCollections[index+1];
---
<Base title={`${paper.title} · Past Paper Questions`} active="papers" description={`${topic.title}: ${paper.questionCount} complete CIE A Level Further Mathematics 9231 past-paper questions in the original ${paper.questions.pages}-page PDF.${paper.answers?' Separate answers included.':''}`} learningResourceType="Past-paper question collection" breadcrumbs={[{name:'Home',href:url()},{name:'Question papers',href:url('papers/')},{name:paper.title,href:collectionUrl(paper)}]} documents={[{name:paper.title+' questions',href:url(paper.questions.file)},...(paper.answers?[{name:paper.title+' answers',href:url(paper.answers.file)}]:[])]}>
<div class="page-heading paper-reader-heading"><span class="eyebrow">{moduleFor(paper.module).short} <span>/</span> ORIGINAL QUESTION COLLECTION</span><h1>{paper.title}</h1><p>CIE A Level Further Mathematics (9231) · {paper.questionCount} complete questions · {paper.questions.pages} original pages.</p></div>
<div class="paper-reader-actions"><a class="button primary" href={url(paper.questions.file)} target="_blank" rel="noopener">Open question PDF <Icon name="external" size={15}/></a><a class="button secondary" href={url(paper.questions.file)} download>Download questions</a>{paper.answers&&<a class="button secondary" href={url(paper.answers.file)} target="_blank" rel="noopener">Open answers PDF <Icon name="external" size={15}/></a>}<a class="text-link" href={formulaSheetUrl} target="_blank" rel="noopener">MF19 formula sheet ↗</a></div>
<p class="paper-reader-help">Read the original pages below. Open the PDF for full-screen zoom or selectable text.</p>
<div class="paper-pages">{paper.previews.map((preview,i)=><figure class="source-paper-page" id={`page-${preview.page}`} data-source-page={preview.page}><figcaption><span>Original page {preview.page} of {paper.questions.pages}</span><a href={`${url(paper.questions.file)}#page=${preview.page}`} target="_blank" rel="noopener">Open in PDF ↗</a></figcaption><a href={`${url(paper.questions.file)}#page=${preview.page}`} target="_blank" rel="noopener" aria-label={`Open original page ${preview.page} in the complete PDF`}><img src={url(preview.file)} width={preview.width} height={preview.height} loading={i===0?'eager':'lazy'} decoding="async" alt={`${paper.title}, original page ${preview.page}. All printed question parts and diagrams are preserved; use the PDF link for selectable text.`}/></a></figure>)}</div>
<div class="paper-reader-details"><p><strong>Question source</strong> {paper.questions.source}</p>{paper.answers?<p><strong>Answer source</strong> {paper.answers.source} · {paper.answers.pages} pages, including the supplied mark schemes and commentary.</p>:<p>No separate answer file was supplied for this collection.</p>}<p>The PDFs are copied intact from the supplied folder. No questions have been rewritten, divided into smaller exercises or reordered.</p></div><div class="paper-reader-navigation"><a class="text-link" href={topicUrl(topic)}>Review {topic.title} <Icon name="arrow" size={15}/></a>{next&&<a class="text-link" href={collectionUrl(next)}>Next collection <Icon name="arrow" size={15}/></a>}</div>
</Base>
