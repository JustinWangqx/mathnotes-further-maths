---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import {practiceMatches} from '../../data/practice-matches';
import {questionTypes} from '../../data/question-types';
import {paperCollections,collectionUrl,type PaperCollection} from '../../data/paper-collections';
import {topics,topicUrl,moduleFor,url,formulaSheetUrl} from '../../data/curriculum';
export function getStaticPaths(){return paperCollections.map(paper=>({params:{collection:paper.id},props:{paper}}));}
const {paper}=Astro.props as {paper:PaperCollection};
const topic=topics.find(t=>t.id===paper.topic)!;
const index=paperCollections.findIndex(p=>p.id===paper.id);
const next=paperCollections[index+1];
const methods=questionTypes[paper.topic].map(t=>({id:t.id,key:`${paper.topic}:${t.id}`,title:`题型 ${String(t.number).padStart(2,'0')}: ${t.title}`,href:`${topicUrl(topic)}#${t.id}`}));
---
<Base title={`${paper.title} · 历年试题`} active="papers" description={`${topic.title} · CIE A Level Further Mathematics 9231 历年试题。共 ${paper.questionCount} 题，原件 ${paper.questions.pages} 页。${paper.answers?'附单独的答案 PDF。':''}`} learningResourceType="Past-paper question collection" breadcrumbs={[{name:'首页',href:url()},{name:'历年试题',href:url('papers/')},{name:paper.title,href:collectionUrl(paper)}]} documents={[{name:paper.title+' · 试题',href:url(paper.questions.file)},...(paper.answers?[{name:paper.title+' · 答案',href:url(paper.answers.file)}]:[])]}>
<div class="page-heading paper-reader-heading"><span class="eyebrow">{moduleFor(paper.module).short} <span>/</span> 历年试题</span><h1>{paper.title}</h1><p>CIE A Level Further Mathematics (9231) · {paper.questionCount} 道完整试题 · 原件 {paper.questions.pages} 页。</p></div>
<div class="paper-reader-actions"><a class="button primary" href={url(paper.questions.file)} target="_blank" rel="noopener">打开试题 PDF <Icon name="external" size={15}/></a><a class="button secondary" href={url(paper.questions.file)} download>下载试题</a>{paper.answers&&<a class="button secondary" href={url(paper.answers.file)} target="_blank" rel="noopener">打开答案 PDF <Icon name="external" size={15}/></a>}<a class="text-link" href={formulaSheetUrl} target="_blank" rel="noopener">MF19 公式表 ↗</a></div>
<p class="paper-method-context" hidden data-method-context>相关笔记 · <a data-method-review></a></p>
<p class="paper-reader-help">下方为原件预览。打开 PDF 可放大查看或选取文字。</p>
<div class="paper-pages">{paper.previews.map((preview,i)=><figure class="source-paper-page" id={`page-${preview.page}`} data-source-page={preview.page}><figcaption><span>原件第 {preview.page} 页，共 {paper.questions.pages} 页</span><a href={`${url(paper.questions.file)}#page=${preview.page}`} target="_blank" rel="noopener">在 PDF 中打开 ↗</a></figcaption><a href={`${url(paper.questions.file)}#page=${preview.page}`} target="_blank" rel="noopener" aria-label={`在完整 PDF 中打开原件第 ${preview.page} 页`}><img src={url(preview.file)} width={preview.width} height={preview.height} loading={i===0?'eager':'lazy'} decoding="async" alt={`${paper.title}, 原件第 ${preview.page} 页。`}/></a>
  {practiceMatches[paper.id]?.[preview.page] && <div class="type-practice-links">
    <span>相关题型 · 第 {preview.page} 题</span>
    {methods.filter(method => practiceMatches[paper.id][preview.page].includes(method.id)).map(method =>
      <a href={method.href}>{method.title}</a>
    )}
  </div>}
</figure>)}</div>
<div class="paper-reader-details"><p><strong>试题原文件</strong> {paper.questions.source}</p>{paper.answers?<p><strong>答案原文件</strong> {paper.answers.source} · {paper.answers.pages} 页。</p>:<p>本套试题无独立答案 PDF。</p>}<p>试题与答案均保留原版。</p></div><div class="paper-reader-navigation"><a class="text-link" href={topicUrl(topic)}>阅读 {topic.title} 笔记 <Icon name="arrow" size={15}/></a>{next&&<a class="text-link" href={collectionUrl(next)}>下一套试题 <Icon name="arrow" size={15}/></a>}</div>
<script type="application/json" id="collection-methods" set:html={JSON.stringify(methods)}/>
<script>
  const selected=new URLSearchParams(location.search).get('method');
  const methods:{key:string;title:string;href:string}[]=JSON.parse(document.querySelector('#collection-methods')!.textContent!);
  const method=methods.find(m=>m.key===selected);
  if(method){
    const link=document.querySelector<HTMLAnchorElement>('[data-method-review]')!;link.href=method.href;link.textContent=method.title;
    document.querySelector<HTMLElement>('[data-method-context]')!.hidden=false;
  }
</script>
</Base>
