---
import Base from '../../layouts/Base.astro';
import PaperCollectionCard from '../../components/PaperCollectionCard.astro';
import {paperCollections,totalPaperQuestions} from '../../data/paper-collections';
import {modules,topics,formulaSheetUrl} from '../../data/curriculum';
---
<Base title="Question papers" seoTitle="CIE A Level Further Maths Past Paper Questions | MathNotes" description="Cambridge International Further Mathematics 9231 past-paper questions: 15 original topic collections, 121 complete questions and 13 answer PDFs. Free to read or download." active="papers"><div class="page-heading"><span class="eyebrow">CIE 9231 PRACTICE QUESTIONS</span><h1>The whole question.<br/><em>All its parts.</em></h1><p>CIE A Level Further Mathematics (9231) past-paper question collections for each topic. Each PDF keeps its original page order, numbering, subparts and diagrams. Answers open separately.</p></div>
<div class="paper-library-summary"><span><strong>{paperCollections.length}</strong> collections</span><span><strong>{totalPaperQuestions}</strong> complete questions</span><a class="text-link" href={formulaSheetUrl} target="_blank" rel="noopener">MF19 formula sheet ↗</a></div>
<div class="filter-bar"><label>Module<select data-filter="module" aria-label="Module"><option value="all">All modules</option>{modules.filter(m=>paperCollections.some(p=>p.module===m.id)).map(m=><option value={m.id}>{m.title}</option>)}</select></label><label>Topic<select data-filter="topic" aria-label="Topic"><option value="all">All topics</option>{topics.filter(t=>paperCollections.some(p=>p.topic===t.id)).map(t=><option value={t.id}>{t.title}</option>)}</select></label><label class="filter-search">Find a collection<input type="search" data-filter="query" placeholder="Try vectors or 复数"/></label></div>
<p class="result-line"><strong data-result-count>{paperCollections.length}</strong> complete collections</p><div class="paper-list">{paperCollections.map(paper=><PaperCollectionCard paper={paper} filterable/>)}</div><div class="empty-state" data-empty hidden><h2>No matching collections</h2><p>Choose another module or topic.</p></div>
</Base>
