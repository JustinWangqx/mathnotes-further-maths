---
import Base from '../../layouts/Base.astro';
import PaperCollectionCard from '../../components/PaperCollectionCard.astro';
import {paperCollections,totalPaperQuestions} from '../../data/paper-collections';
import {modules,topics,formulaSheetUrl} from '../../data/curriculum';
---
<Base title="历年试题" seoTitle="CIE A Level Further Maths Past Paper Questions | MathNotes" description="Cambridge International Further Mathematics 9231 历年试题。收录 15 套专题试题、121 道完整题目及 13 份答案 PDF。" active="papers"><div class="page-heading"><span class="eyebrow">CIE 9231</span><h1>历年试题</h1><p>按专题浏览 CIE A Level Further Mathematics (9231) 的历年试题。PDF 保留原始页序、题号、小题和图表，答案可单独打开。</p></div>
<div class="paper-library-summary"><span><strong>{paperCollections.length}</strong> 套试题</span><span><strong>{totalPaperQuestions}</strong> 道完整试题</span><a class="text-link" href={formulaSheetUrl} target="_blank" rel="noopener">MF19 公式表 ↗</a></div>
<div class="filter-bar"><label>模块<select data-filter="module" aria-label="模块"><option value="all">全部模块</option>{modules.filter(m=>paperCollections.some(p=>p.module===m.id)).map(m=><option value={m.id}>{m.title}</option>)}</select></label><label>专题<select data-filter="topic" aria-label="专题"><option value="all">全部专题</option>{topics.filter(t=>paperCollections.some(p=>p.topic===t.id)).map(t=><option value={t.id}>{t.title}</option>)}</select></label><label class="filter-search">查找试题<input type="search" data-filter="query" placeholder="例如 Vectors、复数"/></label></div>
<p class="result-line"><strong data-result-count>{paperCollections.length}</strong> 套试题</p><div class="paper-list">{paperCollections.map(paper=><PaperCollectionCard paper={paper} filterable/>)}</div><div class="empty-state" data-empty hidden><h2>未找到匹配的试题</h2><p>试试其他模块或专题。</p></div>
</Base>
