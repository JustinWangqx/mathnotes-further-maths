---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { learnUrl, moduleFor, topics, topicUrl, url } from '../../../data/curriculum';
import { papersForTopic } from '../../../data/paper-collections';

export async function getStaticPaths() {
  return (await getCollection('learn')).map(lesson => {
    const topic = topics.find(topic => topic.id === lesson.data.topicId);
    if (!topic?.slug) throw new Error(`Unknown learning topic: ${lesson.data.topicId}`);
    return { params: { module: topic.module, slug: topic.slug }, props: { lesson, topic } };
  });
}

const { lesson, topic } = Astro.props;
const { Content, headings } = await render(lesson);
const sections = headings.filter(heading => heading.depth === 2);
const module = moduleFor(topic.module);
const papers = papersForTopic(topic.id);
---
<Base title={`Learn ${topic.title}`} active="learn" learningResourceType="Lesson"
  description={`${lesson.data.description} Cambridge International Further Mathematics 9231, ${module.title}.`}
  breadcrumbs={[{ name: 'Home', href: url() }, { name: 'Learn', href: url('learn/') },
    { name: module.title, href: url(`learn/#${module.id}`) }, { name: topic.title, href: learnUrl(topic) }]}>
  <div class="reading-layout">
    <article class="lesson">
      <header class="lesson-heading">
        <span class="eyebrow">{module.short} / SYLLABUS {topic.ref}</span>
        <h1>{topic.title}</h1>
        <p>{lesson.data.description}</p>
        <div class="lesson-meta">
          <a class="text-link" href={topicUrl(topic)}>Revision Notes →</a>
          <button class="print-button" onclick="window.print()">Print lesson</button>
        </div>
      </header>
      <details class="lesson-jump" data-pagefind-ignore>
        <summary>On this page</summary>
        <nav aria-label="Lesson sections">
          {sections.map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}
        </nav>
      </details>
      <div class="prose learning-content"><Content/></div>
      <details class="learning-sources">
        <summary>Original notes used in this lesson</summary>
        <ul>{lesson.data.sources.map(source => <li>{source}</li>)}</ul>
      </details>
      <div class="lesson-links">
        <a href={topicUrl(topic)}>Review question types →</a>
        {papers.length > 0 && <a href={url(`papers/?topic=${topic.id}`)}>Practise with question papers →</a>}
      </div>
    </article>
    <aside class="toc" aria-label="Lesson contents" data-pagefind-ignore>
      <p class="nav-label">ON THIS PAGE</p>
      <nav>{sections.map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav>
    </aside>
  </div>
</Base>
