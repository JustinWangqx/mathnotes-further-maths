---
import { topics, topicUrl } from '../../../data/curriculum';

export function getStaticPaths() {
  return topics.filter(topic => topic.slug).map(topic => ({
    params: { module: topic.module, slug: topic.slug }, props: { topic },
  }));
}
const target = topicUrl(Astro.props.topic);
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8"/>
  <title>专题笔记已合并</title>
  <meta name="robots" content="noindex"/>
  <meta http-equiv="refresh" content={'0;url=' + target + '#concepts'}/>
  <script define:vars={{ target }}>location.replace(target + (location.hash || '#concepts'));</script>
</head>
<body><a href={target + '#concepts'}>前往合并后的专题笔记</a></body>
</html>
