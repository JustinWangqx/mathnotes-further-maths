---
import {getCollection,render} from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PaperCollectionCard from '../../../components/PaperCollectionCard.astro';
import {moduleFor,topics,url,repoUrl} from '../../../data/curriculum';
import {papersForTopic} from '../../../data/paper-collections';
import {questionTypes} from '../../../data/question-types';
export async function getStaticPaths(){const notes=await getCollection('notes');return notes.map(note=>({params:{module:note.data.module,slug:note.id.split('/').pop()},props:{note}}));}
const {note}=Astro.props;
const {Content}=await render(note);
const module=moduleFor(note.data.module);
const topic=topics.find(t=>t.id===note.data.topicId)!;
const papers=papersForTopic(topic.id);
const types=questionTypes[topic.id];
const issueUrl=`${repoUrl}/issues/new?title=${encodeURIComponent(`Correction: ${note.data.title}`)}&body=${encodeURIComponent('Page: '+note.data.title+'\n\nSection / question:\n\nWhat should change:\n\nReason or working:\n')}`;
---
<Base title={`${note.data.title} Notes`} description={`${note.data.title} revision for CIE A Level Further Mathematics 9231, ${module.title}: ${types.length} exam question types with short methods, formulas and worked examples.`} active="notes" learningResourceType="Revision notes" breadcrumbs={[{name:'Home',href:url()},{name:'Topic map',href:url('notes/')},{name:module.title,href:url(`9231/${module.id}/`)},{name:note.data.title,href:Astro.url.pathname}]}><span class="sr-only" data-pagefind-meta="type">Study notes</span><span class="sr-only" data-pagefind-filter="module">{module.title}</span><div class="sr-only" data-pagefind-weight="0.5">{topic.aliases.join(' ')}</div>

<div class="reading-layout"><article class="lesson"><div class="lesson-heading"><span class="eyebrow">{module.short} <span> / </span> SYLLABUS {note.data.syllabus}</span><h1>{note.data.title}</h1><p>{note.data.description}</p><div class="lesson-meta"><span class="type-count">{types.length} question types</span><span>Updated 29 Oct 2026</span><button class="print-button" onclick="window.print()">Print notes</button></div></div>
<details class="lesson-jump" data-pagefind-ignore><summary>Jump to question type <span>{types.length} types ↓</span></summary><nav aria-label="Jump to question type">{types.map(type=><a href={`#${type.id}`} data-progress-key={`${topic.id}:${type.id}`} data-progress-title={type.title}>Type {String(type.number).padStart(2,'0')}: {type.title}</a>)}{papers.length>0&&<a href="#papers">Practice collections</a>}</nav></details>
<div class="exam-route" aria-label="Note format"><span>QUESTION TYPE</span><span aria-hidden="true">→</span><span>METHOD & FORMULA</span><span aria-hidden="true">→</span><span>WORKED EXAMPLE</span></div><div class="prose exam-guide"><Content/></div>
{papers.length>0&&<section id="papers" class="topic-practice"><span class="eyebrow">PAST-PAPER COLLECTIONS</span><h2>Try the complete questions.</h2><p class="muted">Practice questions with every subpart and diagram kept together. Open the original PDFs or read the complete pages below.</p>{papers.map(paper=><PaperCollectionCard paper={paper}/>)}</section>}
<div class="completion-box"><div><strong data-topic-progress={topic.id} data-total={types.length}>0/{types.length} confident</strong><p data-progress-storage>Saved on this device.</p></div><a class="text-link" href={url('notes/')}>See progress on the topic map →</a></div>
<div class="source-note"><strong>Source references</strong><p>Question types follow the annotated study collection. Textbook examples are identified by their example number and note page; formula-only illustrations are labelled separately. This page covers the listed question types. Independent teacher review has not yet been recorded.</p><details><summary>Source collection references</summary><ul>{note.data.sources.map(source=><li>{source}</li>)}</ul><p>Original lesson-note PDFs are not published here. Question collections and available answers are available as intact original PDFs in the Question papers library.</p></details><div class="source-links"><a href={`${url('papers/')}?topic=${topic.id}`}>Question collections ↗</a><a href={issueUrl}>Suggest a correction ↗</a></div></div>
</article><aside class="toc" aria-label="Question types" data-pagefind-ignore><p class="nav-label">QUESTION TYPES</p><nav>{types.map(type=><a href={`#${type.id}`}><span data-progress-key={`${topic.id}:${type.id}`} data-progress-title={type.title} class="toc-type-number">{String(type.number).padStart(2,'0')}</span>{type.title}</a>)}{papers.length>0&&<a href="#papers">Question collections</a>}</nav><div class="toc-tip"><span class="small-serif">Exam routine</span><p>Identify the type. Write the formula. Substitute carefully.</p></div></aside></div>
</Base>
