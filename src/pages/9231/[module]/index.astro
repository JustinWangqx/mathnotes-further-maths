---
import Base from '../../../layouts/Base.astro';
import TopicRows from '../../../components/TopicRows.astro';
import {modules,topics,url} from '../../../data/curriculum';
export function getStaticPaths(){return modules.map(module=>({params:{module:module.id},props:{module}}));}
const {module}=Astro.props;
const collection=topics.filter(t=>t.module===module.id);
---
<Base title={`${module.title} 笔记`} description={`CIE A Level Further Mathematics 9231 ${module.title} · ${collection.length} 个专题的概念、推导和题型例题。`} active="notes" breadcrumbs={[{name:'首页',href:url()},{name:'专题笔记',href:url('notes/')},{name:module.title,href:url(`9231/${module.id}/`)}]}><div class="page-heading"><span class="eyebrow">CIE 9231 <span>/</span> {module.paper}</span><h1>{module.title}</h1><p>{module.description}</p></div><div class="section-heading"><h2>专题目录</h2><span class="muted">{collection.length} 个专题</span></div><TopicRows topics={collection}/></Base>
