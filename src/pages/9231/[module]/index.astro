---
import Base from '../../../layouts/Base.astro';
import TopicRows from '../../../components/TopicRows.astro';
import {modules,topics,url} from '../../../data/curriculum';
export function getStaticPaths(){return modules.map(module=>({params:{module:module.id},props:{module}}));}
const {module}=Astro.props;
const collection=topics.filter(t=>t.module===module.id);
---
<Base title={`${module.title} Notes`} description={`CIE A Level Further Mathematics 9231 ${module.title} revision: ${collection.length} available topic guides with numbered exam question types, methods and worked examples.`} active="notes" breadcrumbs={[{name:'Home',href:url()},{name:'Topic map',href:url('notes/')},{name:module.title,href:url(`9231/${module.id}/`)}]}><div class="page-heading"><span class="eyebrow">CIE 9231 <span>/</span> {module.paper}</span><h1>{module.title}</h1><p>{module.description}</p></div><div class="section-heading"><h2>Your topics, in order</h2><span class="muted">{collection.length} topics from your notes</span></div><TopicRows topics={collection}/></Base>
