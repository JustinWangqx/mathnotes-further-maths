---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {papers} from '../data/papers';
import {modules,moduleFor,papersUrl} from '../data/curriculum';
---
<Base title="Past papers & exam references" active="papers"><div class="page-heading"><span class="eyebrow">CONNECT THE METHOD TO THE EXAM</span><h1>Put your knowledge<br/><em>in context.</em></h1><p>Official Cambridge papers and matching mark schemes. Selected specimen questions connect directly to the topics in this notebook.</p></div>
<div class="filter-bar"><label>Module<select data-filter="module" aria-label="Module"><option value="all">All modules</option>{modules.slice(0,3).map(m=><option value={m.id}>{m.title}</option>)}</select></label><label>Year<select data-filter="year" aria-label="Year"><option value="all">All years</option><option value="2024">2024</option><option value="2020">2020</option></select></label><label>Series<select data-filter="session" aria-label="Series"><option value="all">All series</option><option value="june">May / June</option><option value="specimen">Specimen</option></select></label></div><p class="result-line"><strong data-result-count>6</strong> paper sets <span>· PDFs open on Cambridge International.</span></p>
<div class="paper-list">{papers.map(p=><article class="paper-card" data-filter-card data-module={p.module} data-year={p.year} data-session={p.session}><div class="card-meta"><span class="tag">{moduleFor(p.module).short} <span>·</span> {p.code}</span><span>{p.year} <span>·</span> {p.session==='specimen'?'Specimen':'May / June'}</span></div><h3>{p.title}</h3><p>{p.description}</p><div class="paper-links"><a href={p.paper} class="button secondary">Question paper <Icon name="external" size={13}/></a><a href={p.markScheme} class="button secondary">Mark scheme <Icon name="external" size={13}/></a></div>{p.references.length>0&&<div class="paper-question-list"><span class="eyebrow">TOPIC CONNECTIONS</span><ul>{p.references.map(r=><li><a href={`${p.paper}#page=${r.page}`}>{r.label} ↗</a><span> · PDF page {r.page}</span></li>)}</ul></div>}</article>)}</div><div class="empty-state" data-empty hidden><h2>No matching paper sets</h2><p>Try a different year, series or module.</p><a class="button secondary" href="./">Reset filters</a></div>
<div class="notice"><Icon name="info"/><div><strong>Use the right syllabus</strong><p>This is a selected reference library, not a complete archive. Older and specimen papers can differ from your exam-year requirements. Check the current syllabus and find more materials on <a href={papersUrl}>Cambridge’s official resource page</a>. Links and specimen question references checked 29 October 2026.</p></div></div>
</Base>
