---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {syllabusUrl,papersUrl,url} from '../data/curriculum';
const resources=[
 {icon:'map',title:'The official syllabus',description:'Cambridge’s 2026–2027 9231 syllabus, including subject content, assessment details and the MF19 formulae and statistical tables.',label:'Open syllabus PDF',href:syllabusUrl},
 {icon:'papers',title:'Past papers & reports',description:'Find Cambridge’s publicly available question papers, mark schemes, examiner reports and specimen materials.',label:'Visit Cambridge International',href:papersUrl},
 {icon:'book',title:'Published resources',description:'Explore resources listed by Cambridge for Further Mathematics. Check that any book you choose matches your exam-year syllabus.',label:'Explore published resources',href:'https://www.cambridgeinternational.org/programmes-and-qualifications/cambridge-international-as-and-a-level-mathematics-further-9231/published-resources/'},
 {icon:'function',title:'Mathematics prerequisites',description:'The 9709 Mathematics syllabus provides the prior mathematics background used in Further Mathematics.',label:'Visit the 9709 subject page',href:'https://www.cambridgeinternational.org/programmes-and-qualifications/cambridge-international-as-and-a-level-mathematics-9709/'},
];
---
<Base title="Resources" active="resources"><div class="page-heading"><span class="eyebrow">A FEW TRUSTED STARTING POINTS</span><h1>Keep good resources<br/><em>within reach.</em></h1><p>Official syllabus and exam resources to use alongside your notes.</p></div><div class="resource-grid">{resources.map(r=><article class="resource-card"><Icon name={r.icon} size={27}/><h2>{r.title}</h2><p>{r.description}</p><a class="text-link" href={r.href}>{r.label} <Icon name="external" size={14}/></a></article>)}</div><div class="notice"><Icon name="book"/><div><strong>Your notes and the original sources</strong><p>MathNotes provides original explanations and practice. Exam papers and published textbooks stay with their publishers. Use the <a href={url('past-papers/')}>exam reference library</a> to find official papers and matching mark schemes.</p></div></div></Base>
