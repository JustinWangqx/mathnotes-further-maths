---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {syllabusUrl,formulaSheetUrl,url} from '../data/curriculum';
const resources=[
 {icon:'formula',title:'MF19 formula sheet',description:'Cambridge’s List of formulae and statistical tables for Mathematics (9709) and Further Mathematics (9231).',label:'Open formula sheet PDF',href:formulaSheetUrl},
 {icon:'map',title:'The official syllabus',description:'Cambridge’s 2026–2027 9231 syllabus, including subject content and assessment details.',label:'Open syllabus PDF',href:syllabusUrl},
 {icon:'papers',title:'Your question collections',description:'Complete original question PDFs from the supplied folder, with separate answer files where available.',label:'Open question papers',href:url('papers/')},
 {icon:'book',title:'Your topic map',description:'The 14 topics in the current notes, grouped by module and ordered by syllabus topic.',label:'Browse the topic map',href:url('notes/')},
];
---
<Base title="Resources" active="resources"><div class="page-heading"><span class="eyebrow">KEEP THE REFERENCES CLOSE</span><h1>The sheet.<br/><em>And the sources.</em></h1><p>The official formula booklet and syllabus, alongside your notes and question collections.</p></div><div class="resource-grid">{resources.map(r=><article class="resource-card"><Icon name={r.icon} size={27}/><h2>{r.title}</h2><p>{r.description}</p><a class="text-link" href={r.href}>{r.label} <Icon name="external" size={14}/></a></article>)}</div></Base>
